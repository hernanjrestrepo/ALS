{
    "name": "als-xmart-desktop",
    "version": "1.0.0",
    "description": "ALS Xmart - Aplicación de escritorio",
    "main": "main.js",
    "author": "ALS / Paradixe",
    "scripts": {
        "start": "electron .",
        "dist": "electron-builder",
        "dist:win": "electron-builder --win",
        "dist:mac": "electron-builder --mac"
    },
    "devDependencies": {
        "electron": "^33.2.0",
        "electron-builder": "^25.1.8"
    },
    "build": {
        "appId": "xyz.paradixe.als-xmart",
        "productName": "ALS Xmart",
        "directories": {
            "output": "release",
            "buildResources": "build"
        },
        "files": [
            "main.js",
            "preload.js"
        ],
        "win": {
            "target": "nsis",
            "icon": "build/icon.png"
        },
        "mac": {
            "target": "dmg",
            "icon": "build/icon.png",
            "category": "public.app-category.business"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true
        }
    }
}
