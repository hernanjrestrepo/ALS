PORT=4000
DATABASE_URL="file:./dev.db"

# Genera un valor aleatorio de al menos 32 caracteres. El servidor no arranca
# con un secreto débil o de ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# Origenes permitidos por CORS (separados por coma)
CORS_ORIGINS="http://localhost:1612"
FRONTEND_URL="http://localhost:1612"

# Clave compartida para la integracion externa (POST /api/oits/from-url)
INTEGRATION_API_KEY=""

# Password del usuario administrador creado por los scripts de seed
SEED_ADMIN_PASSWORD=""

OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="gpt-oss"

# Web Push VAPID Keys (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@serambiente.com"
